{
  "info": {
    "_postman_id": "patternpilot-complete-api-v1",
    "name": "PatternPilot Complete API - 40 Endpoints",
    "description": "Complete API collection for PatternPilot AI-SaaS trading platform\n- 29 Node.js Backend Endpoints (Port 3001)\n- 11 Python Backend Endpoints (Port 3002)\n- JWT Authentication included",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Setup & Authentication",
      "item": [
        {
          "name": "Register New User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test{{$timestamp}}@example.com\",\n  \"password\": \"Test@1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{nodeBaseUrl}}/api/auth/register",
              "host": [
                "{{nodeBaseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Register a new user account"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Register returns 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.environment.set('userId', json.data.id);",
                  "pm.environment.set('testEmail', json.data.email);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login & Get Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"Test@1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{nodeBaseUrl}}/api/auth/login",
              "host": [
                "{{nodeBaseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Login to get JWT tokens"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.environment.set('accessToken', json.data.accessToken);",
                  "pm.environment.set('refreshToken', json.data.refreshToken);",
                  "pm.test('Token is valid', function () {",
                  "    pm.expect(json.data.accessToken).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{nodeBaseUrl}}/api/auth/refresh-token",
              "host": [
                "{{nodeBaseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh-token"
              ]
            },
            "description": "Get a new access token using refresh token"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{nodeBaseUrl}}/api/auth/logout",
              "host": [
